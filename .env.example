# ==============================================================================
# Arquivo de Exemplo de Variáveis de Ambiente (.env)
# Copie este arquivo para ".env" (ou deixe o IniciarServidor.bat criá-lo).
# O arquivo ".env" é ignorado pelo Git para proteger suas senhas e chaves.
# ==============================================================================

# Senha para entrar no servidor de Terraria (use N/A para deixar sem senha)
TMOD_PASS=suasenha

# Provedor de rede padrão: radmin | tailscale | hybrid | local
NETWORK_PROVIDER=radmin

# URL do Webhook do Discord (Opcional - para avisos de Servidor Online/Offline/Backups e Painel Nameless Deity)
DISCORD_WEBHOOK_URL=

# Token do Bot do Discord "Nameless Deity" (Opcional - habilita comandos /progresso, /proximo, /bosses, /marcar no Discord)
# Crie gratuitamente em: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Chave de autenticação do Tailscale (Opcional - permite login automático sem navegador)
# Gere em: https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
TS_HOSTNAME=terraria-tmodloader

# Preenchidos automaticamente pelos scripts ao iniciar:
RADMIN_IP=
TAILSCALE_IP=

